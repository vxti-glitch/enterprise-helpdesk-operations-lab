# Real or local-only evidence must never be committed by default.
evidence/private/
evidence/screenshots/*.png
evidence/screenshots/*.jpg
evidence/screenshots/*.jpeg
evidence/screenshots/*.gif
evidence/screenshots/*.pdf
evidence/screenshots/**/*.png
evidence/screenshots/**/*.jpg
evidence/screenshots/**/*.jpeg
evidence/screenshots/**/*.gif
evidence/screenshots/**/*.webp
evidence/screenshots/**/*.svg
evidence/screenshots/**/*.tif
evidence/screenshots/**/*.tiff
evidence/screenshots/**/*.pdf
!evidence/screenshots/.gitkeep
!evidence/screenshots/README.md
!evidence/screenshots/application/
!evidence/screenshots/application/*.png
!evidence/screenshots/lab-executed/
!evidence/screenshots/lab-executed/*.png
!evidence/screenshots/lab-executed/*.jpg
!evidence/screenshots/lab-executed/*.jpeg
!evidence/screenshots/lab-executed/*.gif
!evidence/screenshots/lab-executed/*.webp
!evidence/screenshots/lab-executed/*.svg
!evidence/screenshots/lab-executed/*.tif
!evidence/screenshots/lab-executed/*.tiff
!evidence/screenshots/lab-executed/*.pdf
!evidence/manifests/
!evidence/manifests/*.md

