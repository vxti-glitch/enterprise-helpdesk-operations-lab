# Real or local-only evidence must never be committed by default.
evidence/private/
evidence/screenshots/*.png
evidence/screenshots/*.jpg
evidence/screenshots/*.jpeg
evidence/screenshots/*.gif
evidence/screenshots/*.pdf
!evidence/screenshots/.gitkeep
!evidence/screenshots/README.md
!evidence/screenshots/application/
!evidence/screenshots/application/*.png

# Common secret and certificate formats.
.env
.env.*
*.pfx
*.p12
*.key
*.pem
*.cer
secrets.*
credentials.*
